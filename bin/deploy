#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if command -v docker &>/dev/null; then
  CTR=docker
elif command -v podman &>/dev/null; then
  CTR=podman
else
  echo "ERROR: Neither docker nor podman found in PATH" >&2
  exit 1
fi

echo "Using container runtime: $CTR"
echo "=== Building Reliquary split-container deployment ==="

cd "$PROJECT_ROOT"
BUILD_ROOT=$(mktemp -d)
trap 'rm -rf "$BUILD_ROOT"' EXIT
rsync -a \
  --exclude .git \
  --exclude .data \
  --exclude .dart_tool \
  --exclude frontend/build \
  --exclude 'result*' \
  "$PROJECT_ROOT/" "$BUILD_ROOT/"

for target in api-container thumbnail-worker-container web-container; do
  echo "Building $target..."
  image_path=$(nix build "path:$BUILD_ROOT#$target" --no-link --print-out-paths)
  "$CTR" load < "$image_path"
done

echo
echo "=== Ready to deploy ==="
echo
echo "  cp .env.example .env"
echo "  # Edit .env with production credentials."
echo "  $CTR compose up -d"
