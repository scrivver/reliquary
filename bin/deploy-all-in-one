#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if command -v docker &>/dev/null; then
  CTR=docker
elif command -v podman &>/dev/null; then
  CTR=podman
else
  echo "ERROR: Neither docker nor podman found in PATH" >&2
  exit 1
fi

cd "$PROJECT_ROOT/frontend"
flutter build web --release

cd "$PROJECT_ROOT"
BUILD_ROOT=$(mktemp -d)
trap 'rm -rf "$BUILD_ROOT"' EXIT
rsync -a \
  --exclude .git \
  --exclude .data \
  --exclude .dart_tool \
  --exclude build \
  --exclude 'result*' \
  "$PROJECT_ROOT/" "$BUILD_ROOT/"

image_path=$(nix build "path:$BUILD_ROOT#container" --no-link --print-out-paths)
"$CTR" load < "$image_path"

"$CTR" rm -f reliquary-build >/dev/null 2>&1 || true
"$CTR" create --name reliquary-build reliquary:latest
"$CTR" cp "$PROJECT_ROOT/frontend/build/web/." reliquary-build:/srv/web/
"$CTR" commit reliquary-build reliquary:latest >/dev/null
"$CTR" rm reliquary-build >/dev/null

echo "All-in-one image ready."
echo "  $CTR compose -f docker-compose.all-in-one.yml up -d"
