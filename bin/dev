#!/usr/bin/env bash
set -euo pipefail

if [ -z "${DATA_DIR:-}" ]; then
  echo "ERROR: DATA_DIR is not set. Are you in the dev shell? (nix develop)" >&2
  exit 1
fi

if [ -z "${PC_SOCKET:-}" ]; then
  echo "ERROR: PC_SOCKET is not set. Are you in the dev shell? (nix develop)" >&2
  exit 1
fi

DEV_PROCESS_COMPOSE_FILE="$DATA_DIR/dev-process-compose.yaml"

if [ ! -f "$DEV_PROCESS_COMPOSE_FILE" ]; then
  echo "ERROR: $DEV_PROCESS_COMPOSE_FILE is missing. Re-enter the dev shell with: nix develop" >&2
  exit 1
fi

exec process-compose up -f "$DEV_PROCESS_COMPOSE_FILE" -u "$PC_SOCKET" "$@"
