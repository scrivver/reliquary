# MinIO credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-production

# MinIO bucket name
MINIO_BUCKET=reliquary

# Reliquary admin credentials (seeded on first startup)
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-in-production

# JWT signing secret (must be unique and secret)
JWT_SECRET=change-me-in-production

# Server port
RELIQUARY_PORT=2080

# Explicit Engram file events
EVENTS_ENABLED=true
EVENT_QUEUE=engram.ingest
EVENT_DEVICE_NAME=reliquary

# Durable thumbnail worker
THUMBNAIL_QUEUE=reliquary.thumbnail
THUMBNAIL_DEAD_QUEUE=reliquary.thumbnail.dead
THUMBNAIL_PREFETCH=1
THUMBNAIL_CONCURRENCY=4
THUMBNAIL_MAX_ATTEMPTS=5
